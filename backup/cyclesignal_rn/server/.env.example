# CycleSignal AI — backend proxy environment.
# Copy to `.env` and fill in only the providers you have keys for.
# Every route degrades gracefully (returns 503) when its key is missing,
# and the mobile client falls back to its on-device path. Nothing here is
# ever shipped to the device — these keys stay server-side (PRD #7/#8).

# --- Server ---
PORT=8787
# Comma-separated allowed origins for CORS. Leave empty to allow all (dev only).
CORS_ORIGIN=

# --- Hume AI EVI 3 (voice conversation, Section 5.1) ---
# From https://platform.hume.ai → API keys. Used only to mint 30-min access tokens.
HUME_API_KEY=
HUME_SECRET_KEY=
# The EVI configuration (system prompt + store_symptom_entry tool) is built in the
# Hume dashboard; put its id here so the client can open the right config.
HUME_CONFIG_ID=

# --- OpenAI (symptom extraction, Section 5.2) ---
OPENAI_API_KEY=
# PRD names "GPT-5.4 Mini"; that snapshot is not yet public. gpt-4o-mini is the
# current structured-outputs default. Override when the PRD model ships.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Google Gemini (pattern narrative, Section 5.3) ---
GEMINI_API_KEY=
# PRD names "Gemini 3.1 Flash"; gemini-2.5-flash is the current fast default.
GEMINI_NARRATIVE_MODEL=gemini-2.5-flash

# --- Anthropic (secondary safety classifier, Section 5.5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_SAFETY_MODEL=claude-haiku-4-5

# --- Cartesia (fallback TTS, Section 5.4 — only if EVI is unavailable) ---
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE_ID=
