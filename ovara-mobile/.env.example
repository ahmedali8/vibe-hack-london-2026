# Copy this file to .env and fill in your key. .env is gitignored.
#
# One Z.AI GLM key drives the whole app (diet/workout plans AND daily to-dos).
# Get a key: https://zai-hackathon.zeabur.app/  ·  Docs: https://docs.z.ai/devpack/tool/others
EXPO_PUBLIC_ZAI_API_KEY=your-key-here
EXPO_PUBLIC_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Documented coding models (UPPERCASE): GLM-4.7, GLM-4.5-AIR, GLM-5.1, GLM-5V-Turbo
EXPO_PUBLIC_ZAI_MODEL=GLM-4.7

# Optional legacy fallback — only if you instead use Zhipu BigModel (mainland).
# Leave unset when using the Z.AI hackathon key above.
# EXPO_PUBLIC_GLM_API_KEY=
