# Copy this file to .env and fill in your keys. .env is gitignored.

# Z.AI GLM Coding Plan (diet/workout plans) — https://docs.z.ai/devpack/tool/others
EXPO_PUBLIC_ZAI_API_KEY=your-key-here
EXPO_PUBLIC_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
EXPO_PUBLIC_ZAI_MODEL=GLM-5

# GLM (Zhipu BigModel) — daily cycle-aware to-dos
EXPO_PUBLIC_GLM_API_KEY=your-key-here
EXPO_PUBLIC_GLM_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
EXPO_PUBLIC_GLM_MODEL=glm-4-plus
