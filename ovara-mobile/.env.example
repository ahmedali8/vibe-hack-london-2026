# Copy this file to .env and fill in your key(s). .env is gitignored.
#
# GLM is the primary provider for the whole app (diet/workout plans AND daily to-dos).
# Get a key: https://zai-hackathon.zeabur.app/  ·  Docs: https://docs.z.ai/devpack/tool/others
EXPO_PUBLIC_GLM_API_KEY=your-glm-key-here
EXPO_PUBLIC_GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Documented coding models (UPPERCASE): GLM-5.1, GLM-5V-Turbo, GLM-4.7, GLM-4.5-AIR
# GLM-5.1 is premium (peak hours 14:00-18:00 UTC+8 draw quota at a higher rate).
EXPO_PUBLIC_GLM_MODEL=GLM-5.1

# Claude fallback — used automatically if a GLM call fails (error, quota, parse).
# Set both for resilience; either alone also works. https://console.anthropic.com/
EXPO_PUBLIC_CLAUDE_API_KEY=your-claude-key-here
EXPO_PUBLIC_CLAUDE_BASE_URL=https://api.anthropic.com
# Default claude-opus-4-8 (most capable). For a cheaper/faster fallback use claude-haiku-4-5.
EXPO_PUBLIC_CLAUDE_MODEL=claude-opus-4-8
